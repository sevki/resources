<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="ResProcessNameCell" parent="GtkBox">
    <property name="spacing">12</property>
    <child>
      <object class="GtkButton" id="expander">
        <property name="visible">false</property>
        <property name="valign">center</property>
        <property name="icon-name">pan-down-symbolic</property>
        <property name="tooltip-text" translatable="yes">Collapse or expand child processes</property>
        <accessibility>
          <property name="label" translatable="yes">Collapse or expand child processes</property>
        </accessibility>
        <style>
          <class name="flat"/>
          <class name="circular"/>
          <class name="process-expander"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkImage" id="image">
        <property name="pixel-size">16</property>
        <style>
          <class name="lowres-icon"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkInscription" id="inscription">
        <property name="xalign">0</property>
        <property name="yalign">0.5</property>
        <property name="hexpand">1</property>
        <property name="vexpand">1</property>
        <property name="valign">center</property>
        <property name="text-overflow">2</property>
        <property name="min-chars">12</property>
      </object>
    </child>
  </template>
</interface>